<Window
    x:Class="AdminToolBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AdminToolBox"
    xmlns:controls="using:AdminToolBox.Controls"
    xmlns:models="using:AdminToolBox.Models"
    xmlns:viewmodels="using:AdminToolBox.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AdminToolBox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="ToolGridViewItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="5" />
            </Style>

            <DataTemplate x:Key="ToolItemTemplate" x:DataType="viewmodels:ToolViewModel">
                <Border
                    Width="140"
                    Height="128"
                    Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="{x:Bind Opacity}"
                    ToolTipService.ToolTip="{x:Bind Description}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Image
                            Grid.Row="0"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Bottom"
                            Source="{x:Bind Icon, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            MaxLines="2"
                            Text="{x:Bind Name}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Width="24"
                            Height="24"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="FavoriteButton_Click"
                            DataContext="{x:Bind}"
                            ToolTipService.ToolTip="Basculer favori">
                            <FontIcon
                                FontSize="12"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{ThemeResource SystemAccentColor}"
                                Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Loaded="AppTitleBar_Loaded" SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="0"
                Width="40"
                Height="40"
                Margin="4,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                Click="PaneToggleButton_Click"
                ToolTipService.ToolTip="Basculer le panneau de navigation"
                Visibility="Collapsed">
                <FontIcon FontSize="16" FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" />
            </Button>

            <Image
                x:Name="TitleBarIcon"
                Grid.Column="1"
                Width="16"
                Height="16"
                Margin="12,0,8,0"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="TitleBarAppName"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Text="AdminToolBox" />

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="3"
                Width="330"
                MaxWidth="330"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="Rechercher un outil..."
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Background="Transparent"
            CompactModeThresholdWidth="641"
            DisplayModeChanged="NavView_DisplayModeChanged"
            ExpandedModeThresholdWidth="1008"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavAll" Content="Tous" Tag="All" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECA5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSysteme" Content="Système" Tag="Systeme">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavReseau" Content="Réseau" Tag="Reseau">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSecurite" Content="Sécurité" Tag="Securite">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavActiveDirectory" Content="Active Directory" Tag="ActiveDirectory">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavConsoles" Content="Consoles" Tag="Consoles">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEAAE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="InfoSection" Grid.Row="0" Margin="0,0,0,16">
                <Button
                    x:Name="InfoToggleButton"
                    Width="32"
                    Height="24"
                    Margin="0,0,0,4"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="InfoToggleButton_Click"
                    ToolTipService.ToolTip="Réduire / développer les informations du poste">
                    <FontIcon x:Name="InfoToggleIcon" FontFamily="Segoe Fluent Icons" FontSize="12" />
                </Button>
                <Grid x:Name="InfoPanelsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="LeftInfoBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ItemsControl x:Name="InfoItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InfoItem">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            Margin="0,2,0,0"
                                            VerticalAlignment="Top"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="18"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <StackPanel Width="186" Spacing="2">
                                            <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind Label}" TextWrapping="Wrap" />
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border
                        x:Name="RightInfoBorder"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="20,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ItemsControl x:Name="RightInfoItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InfoItem">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            Margin="0,2,0,0"
                                            VerticalAlignment="Top"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="18"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                        <StackPanel Width="146" Spacing="2">
                                            <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind Label}" TextWrapping="Wrap" />
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
                </StackPanel>

                <ScrollViewer x:Name="ToolsScrollViewer" Grid.Row="1">
                    <StackPanel Spacing="20">
                        <StackPanel x:Name="FavoritesSection" Spacing="8" Visibility="Collapsed">
                            <TextBlock Opacity="0.7" Text="Favoris" />
                            <GridView
                                x:Name="FavoritesGridView"
                                IsItemClickEnabled="True"
                                ItemClick="ToolsGridView_ItemClick"
                                ItemContainerStyle="{StaticResource ToolGridViewItemStyle}"
                                ItemTemplate="{StaticResource ToolItemTemplate}"
                                SelectionMode="None" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="AllToolsHeader"
                                Opacity="0.7"
                                Text="Tous les outils"
                                Visibility="Collapsed" />
                            <GridView
                                x:Name="ToolsGridView"
                                IsItemClickEnabled="True"
                                ItemClick="ToolsGridView_ItemClick"
                                ItemContainerStyle="{StaticResource ToolGridViewItemStyle}"
                                ItemTemplate="{StaticResource ToolItemTemplate}"
                                SelectionMode="None" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    x:Name="SettingsPanel"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    Spacing="20"
                    Visibility="Collapsed">

                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Paramètres" />

                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Thème de l'application" />
                        <ComboBox x:Name="ThemeComboBox" Width="220" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Système" Tag="Default" />
                            <ComboBoxItem Content="Clair" Tag="Light" />
                            <ComboBoxItem Content="Sombre" Tag="Dark" />
                        </ComboBox>
                    </StackPanel>

                    <Border
                        Padding="0,16,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="AdminToolBox" />
                            <TextBlock x:Name="AboutVersionText" />
                            <TextBlock x:Name="AboutBuildDateText" />
                            <TextBlock Text="Développeur : Alexandre ARMENIAN" />
                            <TextBlock Text="Copyright © 2026 Alexandre ARMENIAN" />
                            <TextBlock Opacity="0.7" Text="Logiciel libre sous licence GNU GPL v3, fourni sans aucune garantie." TextWrapping="Wrap" />
                            <HyperlinkButton
                                Padding="0"
                                Content="github.com/pingoo78/AdminToolBox"
                                NavigateUri="https://github.com/pingoo78/AdminToolBox" />
                            <TextBlock x:Name="AboutUpdateStatusText" Margin="0,4,0,0" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
