<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AdminToolBox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <Authors>Alexandre ARMENIAN</Authors>
    <RepositoryUrl>https://github.com/pingoo78/AdminToolBox</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- L'icône de l'app (AppWindow.SetIcon) est lue à l'exécution depuis Assets\AppIcon.ico à côté
       de l'exe : le SDK la copie implicitement pour "build" mais pas pour "publish" sans cette
       déclaration explicite. -->
  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishSingleFile>False</PublishSingleFile>
  </PropertyGroup>

  <!-- dotnet publish omet AdminToolBox.pri, App.xbf et MainWindow.xbf (sorties du compilateur XAML)
       alors que dotnet build les copie normalement — écart connu pour les apps WinUI3 non
       empaquetées. Sans eux, InitializeComponent() ne trouve plus l'interface compilée et
       l'application plante au lancement (0xc000027b dans Microsoft.UI.Xaml.dll). On les force
       explicitement dans la liste des fichiers publiés. -->
  <Target Name="IncludeXamlCompilerOutputInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_XamlCompilerPublishFiles Include="$(OutDir)$(AssemblyName).pri" />
      <_XamlCompilerPublishFiles Include="$(OutDir)*.xbf" />
      <ResolvedFileToPublish Include="@(_XamlCompilerPublishFiles)" Condition="Exists('%(Identity)')">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>