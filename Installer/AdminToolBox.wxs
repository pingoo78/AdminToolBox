<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="AdminToolBox"
    Manufacturer="Alexandre ARMENIAN"
    Version="1.0.0"
    UpgradeCode="3a6716b9-e643-4503-9e7c-eecc150f2157"
    Scope="perMachine">

    <SummaryInformation Description="Installateur AdminToolBox" Manufacturer="Alexandre ARMENIAN" />
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente d'AdminToolBox est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.PublishDir)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/pingoo78/AdminToolBox" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AdminToolBox" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="AdminToolBox">
        <Component Id="StartMenuShortcut" Guid="d1f5f2f0-6c2a-4e3f-9f7e-8a1c2b3d4e5f">
          <Shortcut
            Id="StartMenuShortcutEntry"
            Name="AdminToolBox"
            Description="Boîte à outils d'administration Windows"
            Target="[INSTALLFOLDER]AdminToolBox.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon.ico" />
          <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AdminToolBox" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AdminToolBox" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
      <Files Include="$(var.PublishDir)\**" Directory="INSTALLFOLDER" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
